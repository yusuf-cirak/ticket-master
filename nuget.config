<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin this repo to a single feed so Central Package Management (Directory.Packages.props)
       does not require package-source mapping across the machine-global telerik/hangfire feeds. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
