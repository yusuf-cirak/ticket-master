<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- MSG0005: Mediator warns when a discovered notification (e.g. a domain event) has no registered handler.
         This repo raises domain events for future extensibility before any subscriber exists — intentional, not a bug. -->
    <NoWarn>$(NoWarn);MSG0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Mediator.Abstractions" />
    <!-- SenderTests.cs builds its own ServiceCollection/ServiceProvider end-to-end (not via WebApplicationFactory),
         so this compilation needs its own generated AddMediator() — same reasoning as the AppHost install.
         PrivateAssets=all: don't let the generator flow to any future project that references this test assembly. -->
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Domain\BuildingBlocks.Domain\BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Application\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Infrastructure\BuildingBlocks.Persistence\BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Presentation\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Presentation\BuildingBlocks.Security\BuildingBlocks.Security.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Presentation\BuildingBlocks.Observability\BuildingBlocks.Observability.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Presentation\BuildingBlocks.HealthChecks\BuildingBlocks.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Infrastructure\BuildingBlocks.Configuration.Secrets\BuildingBlocks.Configuration.Secrets.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Presentation\BuildingBlocks.RateLimiting\BuildingBlocks.RateLimiting.csproj" />
    <ProjectReference Include="..\..\src\Modules\Iam\TicketMaster.Modules.Iam\TicketMaster.Modules.Iam.csproj" />
    <ProjectReference Include="..\..\src\Modules\Events\TicketMaster.Modules.Events\TicketMaster.Modules.Events.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Infrastructure\BuildingBlocks.Messaging.Kafka\BuildingBlocks.Messaging.Kafka.csproj" />
  </ItemGroup>

</Project>