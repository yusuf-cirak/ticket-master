<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- NuGet audit advisories (NU19xx) stay visible as warnings but must NOT hard-fail the build: the advisory
         DB updates independently of our code, so a newly-published advisory should not break a green build. Keep
         code warnings as errors. Track + upgrade the flagged transitive packages separately. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- ZLinq: zero-allocation LINQ, default in every project. Global using enables .AsValueEnumerable() everywhere. -->
  <ItemGroup>
    <PackageReference Include="ZLinq" />
    <!-- Source generator that emits the drop-in LINQ from the assembly attribute below (analyzer-only). -->
    <PackageReference Include="ZLinq.DropInGenerator" PrivateAssets="all" />
    <Using Include="ZLinq" />
  </ItemGroup>

  <!-- ZLinq drop-in: generate zero-alloc LINQ that shadows System.Linq for concrete collection types
       (Array | Span | Memory | List) in every assembly — NOT IEnumerable, to avoid the aggressive overload-resolution
       shadowing that DropInGenerateTypes.Everything brings. _Parameter2_IsLiteral emits the enum unquoted. -->
  <ItemGroup>
    <AssemblyAttribute Include="ZLinq.ZLinqDropInAttribute">
      <_Parameter1></_Parameter1>
      <_Parameter2>ZLinq.DropInGenerateTypes.Collection</_Parameter2>
      <_Parameter2_IsLiteral>true</_Parameter2_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
