<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\Domain\BuildingBlocks.Domain\BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Application\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Infrastructure\BuildingBlocks.Persistence\BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Presentation\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Presentation\BuildingBlocks.Modularity\BuildingBlocks.Modularity.csproj" />
    <ProjectReference Include="..\TicketMaster.Modules.Events.Contracts\TicketMaster.Modules.Events.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Defines Mediator requests/handlers directly — Mediator.SourceGenerator (installed only in AppHost) needs
         this visible here to compile them, not just transitively via Application's own reference. -->
    <PackageReference Include="Mediator.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets=analyzers (not "all"): Vogen bundles the generator (analyzers/) and the
         Vogen.SharedTypes runtime lib (lib/) in one package — excluding only "analyzers" stops downstream
         consumers from re-running the generator while the lib/runtime reference still flows to output.
         ExcludeAssets=contentFiles: drops Vogen's redundant contentFiles-shipped Vogen.targets (the real one lives
         in buildTransitive/, unaffected) so IDEs stop showing a no-op "Vogen.targets" node under the dependency. -->
    <PackageReference Include="Vogen" ExcludeAssets="contentFiles" PrivateAssets="analyzers" />
    <!-- PrivateAssets=analyzers (not "all"): Projectables also ships a runtime lib the generated LINQ
         depends on at runtime (confirmed the hard way — PrivateAssets="all" broke every integration test
         with a FileNotFoundException for this assembly). Excluding only "analyzers" stops the generator
         from re-running downstream while keeping that runtime reference flowing to consumers. -->
    <PackageReference Include="EntityFrameworkCore.Projectables" PrivateAssets="analyzers" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
