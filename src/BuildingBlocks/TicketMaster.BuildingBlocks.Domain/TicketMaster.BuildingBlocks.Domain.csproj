<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YC.Monad" />
    <!-- Abstractions only (INotification/IRequest) — no MediatR runtime in the domain. -->
    <PackageReference Include="MediatR.Contracts" />
    <!-- Not PrivateAssets=all: generated value objects reference Vogen.SharedTypes at runtime. -->
    <PackageReference Include="Vogen" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ValueObjects/DisposableEmailDomains.txt" />
  </ItemGroup>

</Project>
