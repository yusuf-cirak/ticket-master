<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Presentation\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Infrastructure\BuildingBlocks.Configuration.Secrets\BuildingBlocks.Configuration.Secrets.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Application\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Infrastructure\BuildingBlocks.Caching\BuildingBlocks.Caching.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Infrastructure\BuildingBlocks.Locking\BuildingBlocks.Locking.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Infrastructure\BuildingBlocks.Messaging.Kafka\BuildingBlocks.Messaging.Kafka.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Presentation\BuildingBlocks.Modularity\BuildingBlocks.Modularity.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Presentation\BuildingBlocks.Security\BuildingBlocks.Security.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Presentation\BuildingBlocks.RateLimiting\BuildingBlocks.RateLimiting.csproj" />
    <ProjectReference Include="..\..\Modules\Platform\TicketMaster.Modules.Platform\TicketMaster.Modules.Platform.csproj" />
    <ProjectReference Include="..\..\Modules\Iam\TicketMaster.Modules.Iam\TicketMaster.Modules.Iam.csproj" />
    <ProjectReference Include="..\..\Modules\Events\TicketMaster.Modules.Events\TicketMaster.Modules.Events.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the outermost project may install this — it source-generates AddMediator() from every referenced
         assembly (Events/Iam/Application/etc.); installing it in more than one project in the deployed app conflicts.
         PrivateAssets=all: analyzer/generator packages flow transitively through a ProjectReference by default, so
         without this, TicketMaster.IntegrationTests (which references this project) would run the generator a
         second time and get duplicate-type errors against this project's own already-compiled generated code. -->
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.Kafka" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MSG0005: Mediator warns when a discovered notification (e.g. a domain event) has no registered handler.
         This repo raises domain events for future extensibility before any subscriber exists — intentional, not a bug. -->
    <NoWarn>$(NoWarn);MSG0005</NoWarn>
  </PropertyGroup>

</Project>
