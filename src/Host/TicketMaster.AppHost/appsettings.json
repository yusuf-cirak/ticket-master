{
  "ServiceName": "ticket.master",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ticketmaster;Username=tm;Password=tm"
  },
  "Redis": {
    "Mode": "Standalone",
    "ConnectionString": "localhost:6379,abortConnect=false,connectTimeout=2000,connectRetry=1",
    "ServiceName": "tm-master",
    "Sentinels": [],
    "Database": 0
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PlatformTopic": "tm.platform.events"
  },
  "Debezium": {
    "ConnectUrl": "http://localhost:8083/"
  },
  "RateLimiting": {
    "Enabled": true,
    "Policies": {
      "burst": { "PermitLimit": 20, "Window": "00:00:05", "SegmentsPerWindow": 5 },
      "quotaRead": { "PermitLimit": 1000, "Window": "01:00:00" },
      "quotaWrite": { "PermitLimit": 200, "Window": "01:00:00" },
      "concurrency": { "PermitLimit": 10 }
    },
    "Tiers": { "anon": 0.25, "authenticated": 1, "internal": 5 },
    "SoftBan": { "Threshold": 2, "Duration": "00:01:00" }
  },
  "Authentication": {
    "Mode": "Symmetric",
    "Issuer": "ticketmaster",
    "Audience": "ticketmaster-api",
    "SigningKey": "dev-only-not-a-secret-change-me-min-32-bytes-0000",
    "Authority": "",
    "RequireHttpsMetadata": false,
    "ClockSkewSeconds": 30
  }
}
